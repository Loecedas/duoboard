---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="DuoDash - 多邻国学习数据可视化仪表盘，展示你的学习进度、连胜记录和 XP 历史"
    />
    <meta name="theme-color" content="#58cc02" />
    <meta name="color-scheme" content="light dark" />

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('duodash:theme');
          const mode = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const resolved = mode === 'system' ? (prefersDark ? 'dark' : 'light') : mode;
          document.documentElement.dataset.theme = resolved;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <!-- DNS Prefetch for faster connections -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- Preconnect to external origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Inline critical CSS for LCP optimization -->
    <style>
      /* Critical styles for above-the-fold content */
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f7f7f7;
      }
      .min-h-screen {
        min-height: 100vh;
      }
      .bg-\[\#f7f7f7\] {
        background-color: #f7f7f7;
      }
      html[data-theme='dark'] body {
        background-color: #0f172a;
      }
      .text-4xl {
        font-size: 2.25rem;
        line-height: 2.5rem;
      }
      .font-extrabold {
        font-weight: 800;
      }
      .text-gray-800 {
        color: rgb(31 41 55);
      }
      .mb-2 {
        margin-bottom: 0.5rem;
      }
      .mb-10 {
        margin-bottom: 2.5rem;
      }
      .py-8 {
        padding-top: 2rem;
        padding-bottom: 2rem;
      }
      .px-4 {
        padding-left: 1rem;
        padding-right: 1rem;
      }
      .max-w-7xl {
        max-width: 80rem;
      }
      .mx-auto {
        margin-left: auto;
        margin-right: auto;
      }
      .space-y-6 > * + * {
        margin-top: 1.5rem;
      }
      .grid {
        display: grid;
      }
      .gap-4 {
        gap: 1rem;
      }
      .rounded-2xl {
        border-radius: 1rem;
      }
      .bg-white {
        background-color: white;
      }
      .shadow-sm {
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      }
      .p-4 {
        padding: 1rem;
      }
      .border-2 {
        border-width: 2px;
      }
      .border-gray-200 {
        border-color: rgb(229 231 235);
      }
      /* 优化动画性能 */
      * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      /* 防止布局偏移 */
      img {
        max-width: 100%;
        height: auto;
      }
      /* 提升渲染性能 */
      .animate-seq {
        will-change: opacity, transform;
      }
      .rounded-2xl {
        contain: layout style paint;
      }
    </style>

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="DuoDash - 多邻国学习数据可视化仪表盘，展示你的学习进度、连胜记录、XP 历史等统计信息"
    />
    <meta property="og:image" content="/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="DuoDash - 多邻国学习数据可视化仪表盘"
    />
    <meta name="twitter:image" content="/og.jpg" />

    <link rel="icon" type="image/svg+xml" href="/duo-owl.svg" />

    <!-- Optimized font loading with preload -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap"
      as="style"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap"
      media="print"
      onload="this.media='all'"
      crossorigin="anonymous"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap"
        crossorigin="anonymous"
      /></noscript
    >

    <title>{title}</title>
  </head>
  <body class="font-nunito bg-[#f7f7f7] min-h-screen flex flex-col">
    <main class="flex-1">
      <slot />
    </main>
    <footer class="py-4 text-center text-sm text-gray-500">
      © 2025 - {new Date().getFullYear()} · DuoDash
    </footer>
  </body>
</html>

<style is:global>
  /* 防止部分安卓系统（如 MIUI、Chrome Auto Dark）强制反色 */
  @media (prefers-color-scheme: dark) {
    :root {
      /* Dummy variable to let browser know we support dark mode CSS natively */
      --color-scheme-supported: 1;
    }
  }

  :root {
    color-scheme: light;
  }
  html[data-theme='dark'] {
    color-scheme: dark;
  }
  html[data-theme='dark'] body {
    background-color: #0f172a;
  }
  html[data-theme='dark'] .bg-\[\#f7f7f7\] {
    background-color: #0f172a;
  }
  html[data-theme='dark'] .bg-white {
    background-color: #111827;
  }
  html[data-theme='dark'] .bg-gray-50 {
    background-color: #111827;
  }
  html[data-theme='dark'] .bg-gray-100 {
    background-color: #1f2937;
  }
  html[data-theme='dark'] .bg-gray-200 {
    background-color: #334155;
  }
  html[data-theme='dark'] .text-gray-800 {
    color: #f1f5f9;
  }
  html[data-theme='dark'] .text-gray-700 {
    color: #e2e8f0;
  }
  html[data-theme='dark'] .text-gray-600 {
    color: #cbd5e1;
  }
  html[data-theme='dark'] .text-gray-500 {
    color: #94a3b8;
  }
  html[data-theme='dark'] .text-gray-400 {
    color: #94a3b8;
  }
  html[data-theme='dark'] .border-gray-200 {
    border-color: #334155;
  }
  html[data-theme='dark'] .border-gray-100 {
    border-color: #1f2937;
  }
  html[data-theme='dark'] .shadow-sm {
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.35);
  }
  html[data-theme='dark'] .hover\:bg-gray-50:hover {
    background-color: #111827;
  }
  html[data-theme='dark'] .hover\:bg-gray-100:hover {
    background-color: #1f2937;
  }
  html[data-theme='dark'] .hover\:bg-gray-200:hover {
    background-color: #334155;
  }
  html[data-theme='dark'] .hover\:border-gray-200:hover {
    border-color: #475569;
  }
  .footer-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }
  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }
  .footer-link:hover::after {
    width: 100%;
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  ::-webkit-scrollbar-thumb {
    background: #e5e5e5;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #d4d4d4;
  }

  /* Utility to hide scrollbar */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }

  .chart-shell :focus {
    outline: none;
  }

  .chart-shell :focus-visible {
    outline: 2px solid #58cc02;
    outline-offset: 2px;
    border-radius: 8px;
  }

  .chart-shell svg:focus,
  .chart-shell [role='application']:focus,
  .chart-shell [tabindex]:focus:not(:focus-visible) {
    outline: none;
  }
</style>
